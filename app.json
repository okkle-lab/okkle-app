{
  "expo": {
    "name": "Okkle",
    "slug": "okkle",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "okkle",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.okkle.app",
      "icon": "./assets/okkle-icon.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Okkle uses your location to track delivery trip distance for HMRC mileage records.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Okkle uses your location in the background to track delivery trips accurately.",
        "NSPhotoLibraryUsageDescription": "Okkle saves receipts to your photo library.",
        "NSCameraUsageDescription": "Okkle lets you photograph receipts and pay statements.",
        "NSCalendarsUsageDescription": "Okkle adds your HMRC tax deadlines to your calendar so you don't miss them.",
        "NSMotionUsageDescription": "Okkle uses motion to tell when you've started driving, so it can offer to track the trip.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "uk.okkle.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Okkle uses your location to track delivery trip distance.",
          "locationWhenInUsePermission": "Okkle uses your location to track delivery trip distance.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-mail-composer",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/with-sdk56-ios-appdelegate.cjs"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6fffded-a938-4183-9753-f5bccf749033"
      }
    },
    "owner": "henryhikaru93"
  }
}
